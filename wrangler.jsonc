{
  // Cloudflare static-assets deploy for the Astro build in dist/.
  // The name must match the project name in the Cloudflare dashboard.
  "name": "easyguideindia",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
