---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search the guides | Easy Guide India" description="Search every stadium guide, IPL rule and everyday guide on Easy Guide India." noindex>
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div class="wrap max-w-3xl pb-10 pt-12 sm:pt-20">
    <h1 class="display text-[clamp(2.75rem,7vw,4.5rem)]">Search</h1>
    <p class="mt-4 text-lg text-ink-2">Try a ground, a gate number or a rule, such as "wankhede gate 4" or "power bank".</p>
    <div id="search" class="mt-8"></div>
  </div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      var ui = new PagefindUI({ element: '#search', showImages: false, autofocus: true, resetStyles: false });
      var q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    });
  </script>
</BaseLayout>
