---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Easy Guide India" description="This page has moved or does not exist." noindex>
  <div class="wrap pb-10 pt-16 sm:pt-28">
    <p class="kicker">Error 404</p>
    <h1 class="display mt-4 max-w-3xl text-[clamp(3rem,8vw,6rem)]">That page is out of play.</h1>
    <p class="mt-6 max-w-lg text-lg text-ink-2">It may have moved, or the link may be old. Search for what you need or go back to the grounds.</p>
    <div class="mt-9 flex flex-wrap items-center gap-5">
      <a href="/search/" class="btn">Search the site</a>
      <a href="/stadiums/" class="link-quiet">Browse all grounds</a>
    </div>
  </div>
</BaseLayout>
