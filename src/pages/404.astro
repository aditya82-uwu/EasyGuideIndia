---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Easy Guide India" description="This page does not exist.">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-muted">Error 404</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight">Page not found</h1>
    <p class="mt-3 text-muted">The page moved or never existed. Pick a stadium guide to get back on track.</p>
    <a href="/stadiums/" class="mt-6 inline-block rounded-lg bg-accent px-5 py-2.5 font-bold text-ink">Browse stadium guides</a>
  </div>
</BaseLayout>
