---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StadiumCard from '../components/StadiumCard.astro';

const stadiums = (await getCollection('stadiums')).sort((a, b) => a.data.city.localeCompare(b.data.city));
const india = stadiums.filter((s) => s.data.country === 'India');
const abroad = stadiums.filter((s) => s.data.country !== 'India');
---
<BaseLayout
  title="Indian Cricket Stadium Guides: Gates, Parking, Metro & Rules | Easy Guide India"
  description="Match-day guides for IPL and international cricket venues in India: gates, parking, nearest metro, entry time and what you can carry."
>
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
      <h1 class="max-w-2xl text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">Reach the stadium. Get in fast. Know the rules.</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-300">Gates, parking, nearest metro and banned items for every major cricket ground in India.</p>
    </div>
  </section>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h2 class="text-2xl font-bold tracking-tight">Pick your stadium</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {india.map((s) => (
        <StadiumCard href={`/blog/${s.data.legacySlug}/`} name={s.data.name} city={s.data.city} team={s.data.homeTeam} />
      ))}
    </div>
    {abroad.length > 0 && <h2 class="mt-10 text-2xl font-bold tracking-tight">Grounds outside India</h2>}
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {abroad.map((s) => (
        <StadiumCard href={`/blog/${s.data.legacySlug}/`} name={s.data.name} city={s.data.city} team={s.data.homeTeam} />
      ))}
    </div>
  </section>
</BaseLayout>
