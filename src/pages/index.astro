---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StadiumRow from '../components/StadiumRow.astro';
import { byDemand, cardFact } from '../lib/stadiums';
import { ORG, websiteLd, graph } from '../lib/schema';

const all = byDemand(await getCollection('stadiums'));
const india = all.filter((s) => s.data.country === 'India');
const abroad = all.filter((s) => s.data.country !== 'India');
const [lead, ...nextTwo] = india.slice(0, 3);
const rest = india.slice(3);
const href = (s: (typeof all)[number]) => `/blog/${s.data.legacySlug}/`;

const asked = [
  { q: 'Is a power bank allowed inside the stadium?', href: '/finance/ipl-2026-stadium-entry-rules-mandatory-documents/' },
  { q: 'Do I need a physical ticket for an IPL match?', href: '/finance/ipl-2026-stadium-entry-rules-mandatory-documents/' },
  { q: 'How do I reach Chepauk by metro?', href: '/blog/chepauk-stadium-chennai-entry-rules-parking-guide/' },
  { q: 'Where can I park near Narendra Modi Stadium?', href: '/blog/narendra-modi-stadium-ahmedabad-entry-rules-parking-guide/' },
  { q: 'What happens to my ticket if a match is cancelled?', href: '/finance/ipl-2026-ticket-gst-refund-rules-explained/' },
];

const essentials = [
  { href: '/finance/ipl-2026-stadium-entry-rules-mandatory-documents/', title: 'IPL entry rules', text: 'Tickets, ID proof and the full list of banned items.' },
  { href: '/finance/ipl-2026-ticket-gst-refund-rules-explained/', title: 'Tickets, GST and refunds', text: 'How booking works and what you get back if a match is called off.' },
  { href: '/finance/ipl-2026-stadium-parking-fastag-rules/', title: 'Parking and FASTag', text: 'Where to leave the car at every venue.' },
];
---
<BaseLayout
  title="IPL 2027 stadium guides: gates, parking, metro & rules"
  description="Plan your IPL 2027 match day: gates, parking, nearest metro and banned items for every IPL ground in India, from IPL 2026 notices, updated for the new season."
  jsonLd={graph(ORG, websiteLd)}
>
  <section class="wrap grid gap-12 pb-16 pt-12 sm:pt-20 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p class="kicker">IPL 2027 ground guide</p>
      <h1 class="display mt-4 text-[clamp(3.25rem,9vw,7rem)]">Reach the ground. Get in. Know the rules.</h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-2">Gates, parking, the nearest metro and what you cannot carry in, checked for every major IPL ground before match day. IPL 2027 is reported to start around 10 March, so we are updating each guide ahead of the new season.</p>
      <form action="/search/" method="get" role="search" class="mt-9 flex max-w-xl gap-2">
        <label for="q" class="sr-only">Search stadiums, gates or rules</label>
        <input id="q" name="q" type="search" required autocomplete="off" placeholder="Try &quot;wankhede gate 4&quot; or &quot;power bank&quot;"
          class="min-w-0 flex-1 rounded-md border border-rule bg-surface px-4 py-3 text-[0.97rem] placeholder:text-ink-3 focus:border-ink focus:outline-none" />
        <button class="btn" type="submit">Search</button>
      </form>
      <p class="mt-5 text-sm"><a href="/ipl-2027/" class="link-quiet">IPL 2027 stadium guide: what is confirmed, all 12 grounds and a match-day checklist</a></p>
    </div>

    <aside class="lg:col-span-4 lg:col-start-9 lg:pt-3" aria-labelledby="asked-h">
      <h2 id="asked-h" class="label">Asked most this season</h2>
      <ol class="mt-4">
        {asked.map((a, i) => (
          <li>
            <a href={a.href} class="row-link grid grid-cols-[2.5rem_1fr] gap-x-2 text-[0.97rem] font-medium leading-snug">
              <span class="label pt-0.5">{String(i + 1).padStart(2, '0')}</span>
              <span>{a.q}</span>
            </a>
          </li>
        ))}
      </ol>
    </aside>
  </section>

  <section class="wrap pb-6" aria-labelledby="grounds-h">
    <div class="flex items-end justify-between gap-6 border-b border-ink pb-3">
      <h2 id="grounds-h" class="display text-4xl sm:text-5xl">The grounds</h2>
      <a href="/stadiums/" class="link-quiet hidden text-sm sm:inline">All {all.length} guides</a>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-12">
      <a href={href(lead)} class="group relative flex min-h-[19rem] flex-col justify-between rounded-lg bg-ink p-7 text-paper transition-transform duration-300 hover:-translate-y-0.5 lg:col-span-7 lg:p-9" style="box-shadow: 0 18px 40px -22px rgb(23 21 15 / .55)">
        <p class="font-mono text-[0.78rem] text-paper/60">{lead.data.city === lead.data.state ? lead.data.city : `${lead.data.city}, ${lead.data.state}`}</p>
        <div>
          <h3 class="display text-[clamp(2.5rem,5vw,4rem)]">{lead.data.name}</h3>
          <p class="mt-3 max-w-md text-[0.97rem] leading-snug text-paper/75">{cardFact(lead)?.q}: {cardFact(lead)?.a}</p>
          <p class="mt-6 inline-flex items-center gap-2 text-sm font-semibold">Read the guide <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span></p>
        </div>
      </a>
      <div class="grid gap-6 lg:col-span-5">
        {nextTwo.map((s) => (
          <a href={href(s)} class="group flex flex-col justify-between rounded-lg border border-rule bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lift">
            <p class="font-mono text-[0.78rem] text-ink-3">{s.data.city}, {s.data.state}</p>
            <div class="mt-6">
              <h3 class="display text-3xl">{s.data.name}</h3>
              <p class="mt-2 text-[0.93rem] leading-snug text-ink-2">{cardFact(s)?.q}: {cardFact(s)?.a}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <ul class="mt-12">
      {rest.map((s, i) => <li><StadiumRow href={href(s)} name={s.data.name} city={s.data.city} team={s.data.homeTeam} fact={cardFact(s)} index={i + 4} /></li>)}
    </ul>

    {abroad.length > 0 && (
      <>
        <h3 class="label mb-2 mt-14">Outside India</h3>
        <ul>
          {abroad.map((s) => <li><StadiumRow href={href(s)} name={s.data.name} city={s.data.city} team={s.data.homeTeam} fact={cardFact(s)} /></li>)}
        </ul>
      </>
    )}
  </section>

  <section class="wrap mt-20 grid gap-8 lg:grid-cols-12" aria-labelledby="ess-h">
    <div class="lg:col-span-4">
      <h2 id="ess-h" class="display text-4xl sm:text-5xl">Before you go</h2>
      <p class="mt-3 max-w-xs text-ink-2">The rules that apply at every IPL ground.</p>
    </div>
    <ul class="lg:col-span-8">
      {essentials.map((e) => (
        <li>
          <a href={e.href} class="row-link grid gap-1 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <span class="font-semibold tracking-tight">{e.title}</span>
            <span class="text-ink-2">{e.text}</span>
          </a>
        </li>
      ))}
      <li class="border-t border-rule"></li>
    </ul>
  </section>
</BaseLayout>
