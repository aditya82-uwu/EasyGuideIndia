---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Toc from '../components/Toc.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, ORG, websiteLd, breadcrumbLd, articleLd, faqLd, graph } from '../lib/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { path: entry.data.legacyPath }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const url = new URL(Astro.url.pathname, Astro.site).href;
const fmt = (date: Date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const isLegal = d.section === 'page';
const labels = { finance: 'IPL & finance', documents: 'Documents', railway: 'Railway', banking: 'Banking', blog: 'Guides', page: '' };
const sectionLabel = labels[d.section];

const trail = [{ name: 'Home', href: '/' }, ...(d.section !== 'blog' && !isLegal ? [{ name: sectionLabel, href: `/${d.section}/` }] : [])];
const jsonLd = graph(
  ORG,
  websiteLd,
  isLegal ? [] : breadcrumbLd(trail, { name: d.title, url }),
  isLegal ? [] : articleLd({ url, title: d.title, description: d.description, image: `${SITE}/og/default.png`, published: d.published, updated: d.updated }),
  faqLd(d.faqs),
);
const showToc = !isLegal && (headings.filter((h) => h.depth === 2).length > 2 || d.faqs.length > 0);
---
<BaseLayout title={d.title} description={d.description} type={isLegal ? 'website' : 'article'} jsonLd={jsonLd} ads={!isLegal}>
  <article data-pagefind-body={isLegal ? undefined : ''}>
    <header class="wrap pb-8 pt-10 sm:pt-14">
      {!isLegal && <Breadcrumbs trail={trail} current={d.title} />}
      {!isLegal && sectionLabel && <p class="kicker mt-8">{sectionLabel}</p>}
      <h1 class="display max-w-4xl text-[clamp(2.4rem,5.5vw,4.25rem)] {isLegal ? 'mt-4' : 'mt-2'}">{d.title}</h1>
      {!isLegal && <p class="mt-5 font-mono text-[0.78rem] text-ink-3">Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{fmt(d.updated)}</time></p>}
    </header>

    <div class={`wrap grid gap-10 ${showToc ? 'lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16' : ''}`}>
      <div class="min-w-0">
        <div class="prose-egi"><Content /></div>
        {!isLegal && <AdSlot kind="display" />}
        <Faq faqs={d.faqs} />
      </div>
      {showToc && (
        <aside class="hidden lg:block" aria-label="Contents">
          <div class="sticky top-8"><Toc headings={headings} hasFaq={d.faqs.length > 0} /></div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
