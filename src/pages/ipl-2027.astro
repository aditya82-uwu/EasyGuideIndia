---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { SITE, ORG, websiteLd, breadcrumbLd, articleLd, faqLd, graph } from '../lib/schema';
import { IPL_GROUNDS, cardFact } from '../lib/stadiums';

const all = await getCollection('stadiums');
const grounds = IPL_GROUNDS.map((slug) => all.find((s) => s.data.legacySlug === slug)!).filter(Boolean);
const franchise = grounds.slice(0, 10);
const secondHomes = grounds.slice(10);

const CHECKED = new Date('2026-11-01');
const url = `${SITE}/ipl-2027/`;
const title = 'IPL 2027 Stadium Guide: Gates, Parking, Metro & Rules';
const description = 'IPL 2027 match-day guide for every IPL ground in India: what is confirmed so far, entry rules from IPL 2026, parking, nearest metro and a packing checklist.';

const faqs = [
  { q: 'When does IPL 2027 start?', a: 'The official schedule has not been released. BCCI secretary Devajit Saikia has indicated a tentative start around 10 March 2027 and a final around 15 May 2027, according to news reports. Check iplt20.com for the confirmed dates.' },
  { q: 'Are power banks allowed at IPL matches?', a: 'Usually not. Power banks have been on prohibited lists at Wankhede and in Hyderabad and are commonly banned at IPL venues, so charge your phone fully and leave the power bank at home.' },
  { q: 'Do I need a physical ticket for an IPL match?', a: 'Usually not. Most IPL tickets are digital QR tickets scanned at the gate. Follow the instructions on your ticket, because a few venues or ticket categories may differ.' },
  { q: 'What time do gates open for an IPL match?', a: 'Gates opened about three hours before the start at several grounds in IPL 2026, for example 4:30 PM for a 7:30 PM match in Jaipur, Mullanpur and Ahmedabad. Chinnaswamy was reported to open about four hours before.' },
  { q: 'How much GST is charged on IPL tickets?', a: 'IPL tickets carry 40% GST since 22 September 2025. The earlier rate was 28%. Booking fees are charged on top.' },
  { q: 'Which metro station is nearest to each IPL ground?', a: 'Chepauk: Government Estate. Arun Jaitley Stadium: Delhi Gate or ITO. Eden Gardens: Esplanade. Chinnaswamy: Cubbon Park or MG Road. Uppal: Stadium. Narendra Modi Stadium: Motera Stadium. Wankhede and Ekana have no metro at the gate; use Churchgate station for Wankhede, and a cab or feeder bus for Ekana.' },
];

const jsonLd = graph(
  ORG,
  websiteLd,
  breadcrumbLd([{ name: 'Home', href: '/' }], { name: 'IPL 2027 stadium guide', url }),
  articleLd({ url, title, description, image: `${SITE}/og/default.png`, published: new Date('2026-11-01'), updated: CHECKED }),
  faqLd(faqs),
);

const href = (s: (typeof all)[number]) => `/blog/${s.data.legacySlug}/`;
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={title} description={description} type="article" jsonLd={jsonLd}>
  <article data-pagefind-body>
    <header class="wrap pb-8 pt-10 sm:pt-14">
      <Breadcrumbs trail={[{ name: 'Home', href: '/' }]} current="IPL 2027 stadium guide" />
      <p class="kicker mt-8">IPL 2027</p>
      <h1 class="display mt-2 max-w-4xl text-[clamp(2.75rem,7vw,5.25rem)]">IPL 2027 stadium guide</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-2">Gates, parking, nearest metro and banned items for the grounds that host IPL matches. The new season is reported to start around 10 March 2027, and official fixtures and rules are not out yet. Everything below comes from IPL 2026 notices and recent advisories, and we update each ground when 2027 notices appear.</p>
      <p class="mt-4 font-mono text-[0.78rem] text-ink-3">Last checked <time datetime="2026-11-01">{fmt(CHECKED)}</time></p>
    </header>

    <div class="wrap">
      <section aria-labelledby="known-h" class="max-w-[68ch] rounded-lg border border-rule bg-surface p-5 sm:p-6">
        <h2 id="known-h" class="label">What is confirmed so far</h2>
        <dl class="mt-3 divide-y divide-rule text-[0.97rem] leading-snug">
          <div class="py-3"><dt class="font-semibold">Start and final</dt><dd class="mt-1 text-ink-2">BCCI secretary Devajit Saikia has indicated a tentative start around 10 March 2027 and a final around 15 May 2027. The official schedule has not been released.</dd></div>
          <div class="py-3"><dt class="font-semibold">Venues and fixtures</dt><dd class="mt-1 text-ink-2">Not announced. The grounds below are the usual home grounds of the ten franchises, plus two second homes used in recent seasons.</dd></div>
          <div class="py-3"><dt class="font-semibold">Player auction</dt><dd class="mt-1 text-ink-2">Reports point to 16 December 2026 in Goa. The BCCI has not formally confirmed the date.</dd></div>
          <div class="py-3"><dt class="font-semibold">Entry and parking rules</dt><dd class="mt-1 text-ink-2">No IPL 2027 notices yet. The guidance on this page is from IPL 2026.</dd></div>
        </dl>
      </section>

      <section class="mt-14" aria-labelledby="grounds-h">
        <h2 id="grounds-h" class="display text-4xl sm:text-5xl">Ground by ground</h2>
        <p class="mt-3 max-w-[68ch] text-ink-2">Each guide has the nearest metro or station, parking, gates and what you cannot carry in.</p>
        <ul class="mt-6">
          {franchise.map((s) => (
            <li>
              <a href={href(s)} class="row-link group grid items-baseline gap-x-6 gap-y-1 md:grid-cols-[9rem_minmax(0,1fr)_minmax(0,1.1fr)_1.25rem]">
                <span class="text-sm text-ink-3">{s.data.city}</span>
                <span>
                  <span class="block text-[1.05rem] font-semibold leading-snug tracking-tight">{s.data.name}</span>
                  <span class="block text-sm text-ink-3">{s.data.homeTeam}</span>
                </span>
                <span class="text-sm leading-snug text-ink-2">{cardFact(s) ? `${cardFact(s)!.q}: ${cardFact(s)!.a}` : ''}</span>
                <svg class="hidden shrink-0 self-center text-ink-3 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent md:block" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
              </a>
            </li>
          ))}
        </ul>
        <h3 class="label mb-2 mt-10">Second homes used in recent seasons</h3>
        <ul>
          {secondHomes.map((s) => (
            <li>
              <a href={href(s)} class="row-link group grid items-baseline gap-x-6 gap-y-1 md:grid-cols-[9rem_minmax(0,1fr)_minmax(0,1.1fr)_1.25rem]">
                <span class="text-sm text-ink-3">{s.data.city}</span>
                <span>
                  <span class="block text-[1.05rem] font-semibold leading-snug tracking-tight">{s.data.name}</span>
                  <span class="block text-sm text-ink-3">{s.data.homeTeam}</span>
                </span>
                <span class="text-sm leading-snug text-ink-2">{cardFact(s) ? `${cardFact(s)!.q}: ${cardFact(s)!.a}` : ''}</span>
                <svg class="hidden shrink-0 self-center text-ink-3 md:block" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-14 grid gap-8 lg:grid-cols-12" aria-labelledby="pack-h">
        <div class="lg:col-span-4">
          <h2 id="pack-h" class="display text-4xl sm:text-5xl">Match-day checklist</h2>
          <p class="mt-3 max-w-xs text-ink-2">Based on IPL 2026 rules, which are broadly the same at every ground.</p>
        </div>
        <ul class="max-w-[68ch] list-disc space-y-2 pl-5 marker:text-ink-3 lg:col-span-8">
          <li>Keep your digital ticket ready on a charged phone, and use the gate printed on it. Screenshots may not be accepted.</li>
          <li>Carry a government photo ID in case security asks for it.</li>
          <li>Leave power banks, bags, outside food, water bottles, coins and lighters at home. Cloakrooms are rare, so banned items may be confiscated.</li>
          <li>Plan to arrive early. Gates opened about three hours before the start at several grounds in IPL 2026, and security queues run long for evening matches.</li>
          <li>Prefer the metro or train where one is close. Most grounds restrict parking around the stadium on match days.</li>
          <li>Buy tickets only from the franchise&rsquo;s official ticketing partner. IPL tickets carry 40% GST.</li>
        </ul>
      </section>

      <section class="mt-14" aria-labelledby="more-h">
        <h2 id="more-h" class="display text-4xl sm:text-5xl">More IPL guides</h2>
        <ul class="mt-5 max-w-[68ch]">
          <li><a href="/finance/ipl-2026-stadium-entry-rules-mandatory-documents/" class="row-link grid gap-1 sm:grid-cols-[16rem_1fr] sm:gap-6"><span class="font-semibold tracking-tight">IPL entry rules</span><span class="text-ink-2">Tickets, ID proof and the banned items list.</span></a></li>
          <li><a href="/finance/ipl-2026-ticket-gst-refund-rules-explained/" class="row-link grid gap-1 sm:grid-cols-[16rem_1fr] sm:gap-6"><span class="font-semibold tracking-tight">Tickets, GST and refunds</span><span class="text-ink-2">How booking works and what you get back if a match is called off.</span></a></li>
          <li><a href="/finance/ipl-2026-stadium-parking-fastag-rules/" class="row-link grid gap-1 sm:grid-cols-[16rem_1fr] sm:gap-6"><span class="font-semibold tracking-tight">Parking at every ground</span><span class="text-ink-2">Where to park and the better option at each venue.</span></a></li>
          <li><a href="/blog/ipl-playoffs-format-rules-explained/" class="row-link grid gap-1 sm:grid-cols-[16rem_1fr] sm:gap-6"><span class="font-semibold tracking-tight">Playoffs format</span><span class="text-ink-2">Qualifiers, the Eliminator, net run rate and rain rules.</span></a></li>
          <li><a href="/blog/how-to-join-ipl-cricket-trials-selection-process/" class="row-link grid gap-1 sm:grid-cols-[16rem_1fr] sm:gap-6"><span class="font-semibold tracking-tight">How to join the IPL</span><span class="text-ink-2">Trials, selection and the auction process.</span></a></li>
          <li class="border-t border-rule"></li>
        </ul>
      </section>

      <Faq faqs={faqs} />

      <p class="mt-10 max-w-[68ch] border-l-2 border-accent pl-5 text-sm leading-relaxed text-ink-2">Easy Guide India is an independent site and is not affiliated with the BCCI, the IPL or any franchise. <a href="/how-we-check/" class="link-quiet">How we research and check our guides</a>.</p>
    </div>
  </article>
</BaseLayout>
