---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickAnswers from '../../components/QuickAnswers.astro';

export async function getStaticPaths() {
  const stadiums = await getCollection('stadiums');
  return stadiums.map((entry) => ({ params: { slug: entry.data.legacySlug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const fmt = (date: Date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: d.title,
      description: d.description,
      datePublished: d.published.toISOString(),
      dateModified: d.updated.toISOString(),
      author: { '@type': 'Organization', name: 'Easy Guide India' },
      publisher: { '@type': 'Organization', name: 'Easy Guide India' },
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
    },
    ...(d.faqs.length ? [{
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }] : []),
  ],
};
---
<BaseLayout title={d.title} description={d.description} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-3xl px-4 py-8">
    <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/" class="underline">Home</a> / <a href="/stadiums/" class="underline">Stadiums</a> / {d.city}</nav>
    <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{d.name}: gates, parking &amp; entry rules</h1>
    <p class="mt-2 text-sm text-muted">{d.officialName} · {d.city}, {d.state} · Updated {fmt(d.updated)}</p>

    {d.quick.length > 0 && <div class="mt-6"><QuickAnswers items={d.quick} /></div>}

    <div class="prose-egi mt-8">
      {d.transport && <><h2>How to reach {d.name}</h2><ul>{d.transport.map((t) => <li><strong>{t.name}:</strong> {t.detail}</li>)}</ul></>}
      {d.parking && <><h2>Parking</h2><ul>{d.parking.map((p) => <li><strong>{p.name}:</strong> {p.detail}</li>)}</ul></>}
      {(d.tickets || d.gates) && <><h2>Tickets and gates</h2>{d.tickets && <p>{d.tickets}</p>}{d.gates && <p>{d.gates}</p>}</>}
      {d.banned && <><h2>Not allowed inside</h2><ul>{d.banned.map((b) => <li>{b}</li>)}</ul>{d.carry && <p><strong>What to carry:</strong> {d.carry}</p>}</>}

      <Content />

      {d.faqs.length > 0 && <h2>Frequently asked questions</h2>}
      {d.faqs.map((f) => (
        <details class="my-2 rounded-lg border border-line bg-white p-3">
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-2">{f.a}</p>
        </details>
      ))}
    </div>

    <p class="mt-10 rounded-lg bg-info-bg p-4 text-sm text-info">Traffic and parking plans are announced by local traffic police before each big match, and ticket rules by the team or board. Check the latest advisory for your match.</p>
  </article>
</BaseLayout>
