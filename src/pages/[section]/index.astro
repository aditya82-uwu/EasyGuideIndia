---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE, ORG, websiteLd, breadcrumbLd, graph } from '../../lib/schema';

const SECTIONS = {
  finance: { title: 'IPL and finance', desc: 'IPL ticket, entry and tax rules, plus plain-language explainers on gold, markets and tax.' },
  documents: { title: 'Documents and online services', desc: 'Aadhaar, PAN, PM Kisan, e-Shram and other status checks and downloads, step by step.' },
  railway: { title: 'Railway and IRCTC', desc: 'Tatkal booking, cancellation, refunds and train status without the confusion.' },
  banking: { title: 'Banking and payments', desc: 'Balance checks, UPI setup and what to do when a payment fails or money is debited.' },
} as const;

export async function getStaticPaths() {
  return ['finance', 'documents', 'railway', 'banking'].map((section) => ({ params: { section } }));
}

const { section } = Astro.params as { section: keyof typeof SECTIONS };
const info = SECTIONS[section];
const items = (await getCollection('guides'))
  .filter((g) => g.data.section === section)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout
  title={`${info.title} | Easy Guide India`}
  description={info.desc}
  jsonLd={graph(ORG, websiteLd, breadcrumbLd([{ name: 'Home', href: '/' }], { name: info.title, url: `${SITE}/${section}/` }))}
>
  <header class="wrap pb-8 pt-10 sm:pt-14">
    <Breadcrumbs trail={[{ name: 'Home', href: '/' }]} current={info.title} />
    <h1 class="display mt-8 max-w-3xl text-[clamp(2.75rem,7vw,5rem)]">{info.title}</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-2">{info.desc}</p>
  </header>
  <div class="wrap">
    <ul>
      {items.map((g) => (
        <li>
          <a href={`/${g.data.legacyPath}/`} class="row-link grid gap-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] md:gap-10">
            <span class="font-semibold leading-snug tracking-tight">{g.data.title}</span>
            <span class="text-[0.95rem] leading-snug text-ink-2">{g.data.description}</span>
          </a>
        </li>
      ))}
      <li class="border-t border-rule"></li>
    </ul>
  </div>
</BaseLayout>
