---
import { inline } from '../lib/md';
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section aria-labelledby="faq-h" class="mt-14 border-t border-rule pt-8">
    <h2 id="faq-h" class="mb-2 text-[2rem] leading-tight" style="font-family: var(--font-display); letter-spacing: -0.015em;">Frequently asked questions</h2>
    <dl class="max-w-[68ch]">
      {faqs.map((f) => (
        <div class="border-b border-rule py-5 last:border-b-0">
          <dt class="font-semibold leading-snug tracking-tight">{f.q}</dt>
          <dd class="mt-1.5 leading-relaxed text-ink-2" set:html={inline(f.a)} />
        </div>
      ))}
    </dl>
  </section>
)}
