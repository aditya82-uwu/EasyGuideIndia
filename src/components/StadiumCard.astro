---
interface Props { href: string; name: string; city: string; team: string; fact?: { q: string; a: string } }
const { href, name, city, team, fact } = Astro.props;
---
<a href={href} class="flex h-full flex-col rounded-xl border border-line bg-white p-4 shadow-sm transition hover:border-accent hover:shadow">
  <p class="text-xs font-semibold uppercase tracking-wide text-muted">{city}</p>
  <h3 class="mt-1 text-lg font-bold leading-snug">{name}</h3>
  <p class="mt-1 text-sm text-muted">{team}</p>
  {fact && (
    <p class="mt-3 rounded-lg bg-paper px-3 py-2 text-sm"><span class="font-semibold">{fact.q}:</span> {fact.a}</p>
  )}
  <p class="mt-auto pt-3 text-sm font-semibold text-accent-ink">Gates, parking, rules →</p>
</a>
