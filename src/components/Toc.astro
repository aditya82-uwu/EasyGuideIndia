---
interface Props { headings: { depth: number; slug: string; text: string }[]; hasFaq?: boolean }
const { headings, hasFaq = false } = Astro.props;
const items = headings.filter((h) => h.depth === 2 && !/frequently asked questions/i.test(h.text));
---
{(items.length > 2 || hasFaq) && (
  <nav aria-label="On this page" class="text-sm">
    <p class="label mb-3">On this page</p>
    <ol class="space-y-0.5 border-l border-rule">
      {items.map((h) => (
        <li><a href={`#${h.slug}`} class="-ml-px block border-l border-transparent py-1.5 pl-4 leading-snug text-ink-2 transition-colors hover:border-accent hover:text-ink">{h.text}</a></li>
      ))}
      {hasFaq && <li><a href="#faq-h" class="-ml-px block border-l border-transparent py-1.5 pl-4 leading-snug text-ink-2 transition-colors hover:border-accent hover:text-ink">Frequently asked questions</a></li>}
    </ol>
  </nav>
)}
