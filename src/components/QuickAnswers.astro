---
// "At a glance" list. tone: yes (check), no (cross), info (dot). Colour is never the only signal.
interface Props { items: { q: string; a: string; tone: 'yes' | 'no' | 'info' }[]; heading?: string; checked?: Date }
const { items, heading = 'Quick answers', checked } = Astro.props;
const checkedLabel = checked?.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
---
<section aria-labelledby="glance-h" class="overflow-hidden rounded-lg border border-rule bg-surface">
  <h2 id="glance-h" class="label border-b border-rule px-4 py-3 lg:px-5">{heading}</h2>
  <dl class="grid grid-cols-2 gap-px bg-rule lg:grid-cols-1">
    {items.map((i) => (
      <div class="grid grid-cols-[1fr_auto] items-start gap-x-3 bg-surface px-4 py-3 last:odd:col-span-2 lg:px-5">
        <dt class="col-span-2 text-[0.8rem] text-ink-3">{i.q}</dt>
        <dd class="col-span-2 mt-0.5 flex items-start gap-2 text-[0.97rem] font-medium leading-snug">
          {i.tone === 'yes' && (
            <svg class="mt-[3px] shrink-0 text-ok" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-label="Yes" role="img"><path d="m3 8.5 3.2 3.2L13 4.8"/></svg>
          )}
          {i.tone === 'no' && (
            <svg class="mt-[3px] shrink-0 text-no" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-label="No" role="img"><path d="m4 4 8 8M12 4l-8 8"/></svg>
          )}
          {i.tone === 'info' && <span class="mt-[7px] size-[5px] shrink-0 rounded-full bg-ink-3" aria-hidden="true"></span>}
          <span>{i.a}</span>
        </dd>
      </div>
    ))}
  </dl>
  <p class="border-t border-rule bg-surface px-4 py-2.5 font-mono text-[0.72rem] leading-snug text-ink-3 lg:px-5">
    {checkedLabel ? `Checked ${checkedLabel} against news reports and notices.` : 'Taken from match-day notices.'} Rules change by match: confirm on your ticket.
  </p>
</section>
